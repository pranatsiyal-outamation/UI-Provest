{
  // Template for appsettings.Development.json, which is gitignored because it holds
  // the database server and the sign-in passwords in plaintext. Copy this file, drop
  // the ".example", and fill in the real values.

  "ConnectionStrings": {
    // Whatever this points at is what the tool reads and writes. No database name is
    // hardcoded anywhere in the app, so this line alone decides the target.
    "OQMS": "Data Source=<server>,<port>;Initial Catalog=<database>;Integrated Security=True;TrustServerCertificate=True;Pooling=False;Connect Timeout=30;"
  },

  // Sign-in accounts. Every account has identical rights -- this is a gate to stop
  // casual access, not an authorisation model. The username appears in the audit log
  // against every write, which is the reason to give people separate accounts rather
  // than sharing one.
  "Auth": {
    "SessionHours": 8,
    "Users": [
      {
        "Username": "<username>",
        "Password": "<password>",
        "DisplayName": "<Full Name>"
      }
    ]
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  }
}
